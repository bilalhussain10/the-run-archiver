# Copy this file to .streamlit/secrets.toml for local testing,
# or paste these two lines into your app's "Secrets" box on
# https://share.streamlit.io (Settings -> Secrets) when deployed.
#
# Get these values from https://turso.tech (see README for steps).

TURSO_DATABASE_URL = "libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN = "your-auth-token-here"
